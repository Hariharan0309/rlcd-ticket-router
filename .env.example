# Needed only for Jev. Create one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Jev's cost is also shown in INR using a live rate. This is only the backup
# rate for when the live rate can't be fetched (e.g. offline). Leave empty to show USD only then.
USD_INR_RATE=

# Starting position of the threshold slider (0.50 to 0.99)
DEFAULT_THRESHOLD=0.90

# Where Laya runs: auto (GPU if available, else CPU), cuda, or cpu
LAYA_DEVICE=auto
